# SST (generated platform + state)
.sst/

# Root infra node_modules (sst lives here; the apps have their own)
/node_modules/

# .NET Lambda publish artifact produced during `sst deploy`
backend/LoopedIn.Api/.lambda-publish/

# OpenNext build output (regenerated every deploy)
.open-next/

# SST-generated resource types
sst-env.d.ts

# Local environment overrides
.env

# Python bytecode from scripts/ (the mcp app has its own .gitignore)
__pycache__/

# Personal data — NEVER commit. The outreach spreadsheet holds ~150 named individuals' work
# contact details, and the importer's generated SQL + report carry the same data. Committing any
# of it puts personal data in git history permanently, where deleting the file does not remove it.
# The importer regenerates data/ from the spreadsheet on demand (ids are deterministic UUIDv5,
# so a regenerated file is byte-identical), which is what makes this safe to ignore rather than track.
/*.xlsx
/data/
