<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the Microsoft.OpenApi pin below apply to the transitive reference. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.1.0" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.101.4" />
    <PackageVersion Include="DotNetEnv" Version="3.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Transitive via Microsoft.AspNetCore.OpenApi 10.0.9, which resolves 2.0.0 — that version
         carries a high-severity advisory (GHSA-v5pm-xwqc-g5wc / CVE-2026-49451, affecting
         <= 2.7.4) and NuGet audit fails the build because Directory.Build.props sets
         TreatWarningsAsErrors. Pinned to 2.7.5, the first patched release. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>
</Project>