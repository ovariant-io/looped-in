# Copy this file to .env.local and fill in the real value.
# The API loads .env.local at startup for local dev; Docker Compose reads it via
# env_file. Never commit the real .env.local (it is gitignored).

# Neon Postgres connection string (Neon Dashboard → Connect → "Connection string").
# Either Neon's postgresql:// URL (shown below) or a native Npgsql key/value string works.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Clerk authentication. Maps to the "Clerk:Authority" config key (double underscore = section
# separator). Set this to your Clerk Frontend API URL (Clerk Dashboard → API Keys), which the
# API uses for JWKS/OIDC discovery to validate session JWTs. Leave unset to run without auth —
# the API still boots, but protected endpoints (e.g. GET /me) reject every request with 401.
Clerk__Authority=https://YOUR-SLUG.clerk.accounts.dev

# Optional: comma-separated allow-list checked against the token's "azp" (authorized party) claim.
# Clerk__AuthorizedParties=http://localhost:3000,https://your-app.com
