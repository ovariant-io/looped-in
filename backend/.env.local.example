# Copy this file to .env.local and fill in the real value.
# The API loads .env.local at startup for local dev; Docker Compose reads it via
# env_file. Never commit the real .env.local (it is gitignored).

# Neon Postgres connection string (Neon Dashboard → Connect → "Connection string").
# Either Neon's postgresql:// URL (shown below) or a native Npgsql key/value string works.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Clerk authentication. Maps to the "Clerk:Authority" config key (double underscore = section
# separator). Set this to your Clerk Frontend API URL (Clerk Dashboard → API Keys), which the
# API uses for JWKS/OIDC discovery to validate session JWTs. Leave unset to run without auth —
# the API still boots, but protected endpoints (e.g. GET /me) reject every request with 401.
Clerk__Authority=https://YOUR-SLUG.clerk.accounts.dev

# Optional: comma-separated allow-list checked against the token's "azp" (authorized party) claim.
# Clerk__AuthorizedParties=http://localhost:3000,https://your-app.com

# ---- Document storage (S3) -------------------------------------------------------------
# The bucket behind /documents. Maps to the "Documents:Bucket" config key. Leave unset to run
# without storage — the API still boots, but every /documents endpoint reports 503 with the
# reason (curl localhost:5114/documents/ping to see it).
#
# Deployed stages get this automatically from the SST stack. For local dev, point it at a real
# bucket: either the one a deploy created (`npx sst outputs --stage test` prints `bucket`) or
# one you make yourself. A hand-made bucket needs a CORS rule allowing PUT from
# http://localhost:3000, because uploads go straight from the browser to S3.
# Documents__Bucket=looped-in-test-loopedinstorage-abc123

# Optional: the key prefix documents live under. Defaults to "documents/". Changing it moves
# where new documents are written without moving the ones already stored.
# Documents__Prefix=documents/

# Region for the S3 client. Required locally whenever it isn't already set by your AWS profile
# or environment — without a region the SDK cannot construct a client at all, and /documents
# reports 503 saying so. On Lambda the runtime sets this for you.
# AWS_REGION=ap-southeast-2

# Credentials come from the standard AWS chain (environment, ~/.aws/credentials, SSO). The API
# holds no AWS keys in configuration. If you use a named profile, either export AWS_PROFILE
# before starting the API or set it here.
# AWS_PROFILE=default
