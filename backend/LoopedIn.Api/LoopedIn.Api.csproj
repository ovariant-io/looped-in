<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migrations travel inside the assembly, so the same files apply under `dotnet run`, in
         the container, and on Lambda with no content-root assumptions. A wildcard, so adding a
         migration means adding one .sql file and nothing else. -->
    <EmbeddedResource Include="Infrastructure/Database/Migrations/*.sql" />
  </ItemGroup>

</Project>
