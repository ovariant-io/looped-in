# Copy to mcp/.env.local and fill in. .env.local is gitignored.

# Clerk Frontend API URL — the OAuth issuer. Clerk Dashboard → API Keys →
# "Frontend API URL". Same value as the backend's Clerk__Authority.
CLERK_ISSUER=https://your-slug.clerk.accounts.dev

# Public URL the MCP client uses to reach THIS server. For a local Claude Desktop
# test, set this to your tunnel URL (ngrok/cloudflared), e.g.
# https://abc123.ngrok-free.app — it must match the URL you add as the connector,
# because the OAuth Protected Resource Metadata is generated from it. Leave it
# UNSET in the cloud: the server then self-adapts to the URL it is reached at.
# Blank counts as unset, so `SERVER_BASE_URL=` and deleting the line are equivalent.
SERVER_BASE_URL=http://localhost:8000

# Optional: comma-separated allow-list of Host values the self-adapting rewrite will
# accept (only consulted when SERVER_BASE_URL is unset). Unset accepts any
# syntactically valid host, which is what the cloud deploy needs — the API Gateway
# domain isn't knowable until after the stack exists. Narrow it once you know the
# hostname: `npx sst outputs --stage test` prints the MCP URL to take the host from.
# ALLOWED_PUBLIC_HOSTS=abc123.ngrok-free.app

# Looped In .NET API base URL that API-wrapping tools forward the caller's token
# to. http://localhost:5114 for `dotnet run --launch-profile http`;
# http://backend:8080 inside docker compose. Unset = whoami still works, but
# my_api_identity reports that no backend is configured.
BACKEND_URL=http://localhost:5114

# Optional: only set if you've configured Clerk to emit a custom `aud` claim.
# Leaving it unset validates signature + issuer + expiry only.
# CLERK_AUDIENCE=

# Local bind host/port.
HOST=0.0.0.0
PORT=8000
